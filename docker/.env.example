# HomeEye · 部署变量（复制成 .env 再改）
#
#   cp docker/.env.example docker/.env      （compose 自动读同目录的 .env）
#
# 这个文件只管一件事：**数据落在宿主机的哪个路径**。容器内部的路径
# （/data、/rec）是固定的，改这里就够了，不用进容器改配置。
# 改完执行 docker compose up -d 让容器重建生效。

# 配置 + 登录口令哈希 + 自签证书 + 米家授权缓存。
# 想放到大卷上就写绝对路径，例如 /mnt/nas1/homeeye-data。
HE_DATA_VOLUME=../data

# 录像分段（一天能写几十 GB，认真选一块大盘）。容器里固定叫 /rec。
# 换到大卷就写绝对路径，例如 /mnt/nas1/homeeye-rec；换路径后要把旧分段自己搬过去。
# 不想单独挂一块录像盘就删掉 compose 里的那两行（挂载 + HE_REC_DIR），
# 录像会落在 HE_DATA_VOLUME 目录下的 recordings/ 里。
HE_REC_VOLUME=../rec

# 时区。录像文件名按它命名，填错录像时间轴就对不上。
TZ=Asia/Shanghai

# 监听端口（一般不用改）。
HE_PORT=8088
HE_TLS_PORT=8443

# 可选：给 Prometheus 之类的抓取器发一个只读令牌。
# 填了以后 `GET /api/metrics?token=...`（或 Authorization: Bearer ...）免登录可读；
# 留空 = 监控接口和其它 API 一样要登录会话。
# 生成：openssl rand -hex 24
# HE_METRICS_TOKEN=
