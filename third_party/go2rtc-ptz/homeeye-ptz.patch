diff --git a/pkg/xiaomi/miss/cmdreader.go b/pkg/xiaomi/miss/cmdreader.go
new file mode 100644
index 0000000..2d4bbb7
--- /dev/null
+++ b/pkg/xiaomi/miss/cmdreader.go
@@ -0,0 +1,223 @@
+package miss
+
+import (
+	"encoding/binary"
+	"encoding/hex"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// 命令通道（channel 0）必须有人持续读走。
+//
+// 摄像头对每一条命令都会回一个应答（云台 0x112→0x113、对讲 0x106→0x107 …），
+// 而 channel0 的接收缓冲区只有 10 个槽。没人读的话，灌满之后
+// cs2.dataChannel.Push 会返回 "pop buffer is full"，
+// cs2 的 worker 直接退出 —— 整条 P2P 连接被关闭，
+// 之后所有命令都会报 broken pipe / cs2: EOF。
+//
+// 这个协程顺带把云台回包 cmdMotorRes(0x113) 里的角度记下来，
+// 好让 /api/xiaomi/motor 和 /api/xiaomi/ptz 能回显摄像头当前朝向。
+type cmdReader struct {
+	mu       sync.Mutex
+	angle    int
+	elev     int
+	hasPos   bool
+	motorSeq uint64 // 每收到一个 cmdMotorRes 就 +1，用来判断「是不是新的回包」
+	lastCmd  uint32
+	lastMsg  string
+	lastRaw  string
+}
+
+// 已知的应答命令码。用来在原始缓冲区里定位 cmd 的位置
+// （小米摄像头的回包在 cmd 前面还带 4 个字节，而且 cmd 是大端的）。
+var knownCmdRes = map[uint32]bool{
+	0x101: true, // authRes
+	0x107: true, // speakerStartRes
+	0x10A: true, // streamCtrlRes
+	0x10C: true, // audioFormatRes
+	0x10E: true, // playbackRes
+	0x111: true, // devInfoRes
+	0x113: true, // motorRes
+}
+
+// 通道 0 弹出缓冲区布局是：[4 字节 cmd(大端)][加密的 body]。
+// 外层 cmd 一般是 0x1001（cmdEncoded，表示 body 是加密的）。
+//
+// 解密后的 body 才是真正的应答：[4 字节 命令号(大端)][负载]。
+// 比如云台回包解密后是 00 00 01 13 + {"ret":..,"angle":..,"elevation":..}。
+func splitCmd(buf []byte) (uint32, []byte) {
+	if len(buf) < 4 {
+		return 0, buf
+	}
+	return binary.BigEndian.Uint32(buf[:4]), buf[4:]
+}
+
+// rawCommandReader 可选接口：底层能拿到未经拆分的原始命令缓冲区。
+type rawCommandReader interface {
+	ReadCommandRaw() ([]byte, bool)
+}
+
+func (r *cmdReader) onCommand(cmd uint32, plain []byte, raw []byte) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	r.lastCmd = cmd
+	r.lastMsg = string(plain)
+	r.lastRaw = hex.EncodeToString(raw)
+
+	if cmd != cmdMotorRes {
+		return
+	}
+
+	r.motorSeq++
+
+	if a, ok := jsonInt(r.lastMsg, "angle"); ok {
+		r.angle = a
+		if e, ok2 := jsonInt(r.lastMsg, "elevation"); ok2 {
+			r.elev = e
+		}
+		r.hasPos = true
+	}
+}
+
+func (r *cmdReader) snapshot() (seq uint64, angle, elev int, has bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.motorSeq, r.angle, r.elev, r.hasPos
+}
+
+func (r *cmdReader) last() (cmd uint32, msg, raw string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.lastCmd, r.lastMsg, r.lastRaw
+}
+
+// jsonInt 从一段 JSON 文本里取某个整数字段。
+// 不用 encoding/json 是因为回包结构不完全固定（有的带 ret，有的直接是对象），
+// 宽松一点匹配更稳。
+func jsonInt(s, key string) (int, bool) {
+	i := strings.Index(s, "\""+key+"\"")
+	if i < 0 {
+		return 0, false
+	}
+	j := i + len(key) + 2
+	for j < len(s) && (s[j] == ' ' || s[j] == ':') {
+		j++
+	}
+	neg := false
+	if j < len(s) && s[j] == '-' {
+		neg = true
+		j++
+	}
+	start := j
+	for j < len(s) && s[j] >= '0' && s[j] <= '9' {
+		j++
+	}
+	if j == start {
+		return 0, false
+	}
+	n, err := strconv.Atoi(s[start:j])
+	if err != nil {
+		return 0, false
+	}
+	if neg {
+		n = -n
+	}
+	return n, true
+}
+
+// looksJSON 粗判一段字节是不是 JSON 文本。
+func looksJSON(b []byte) bool {
+	return strings.Contains(string(b), "{")
+}
+
+// StartCommandReader 启动命令通道读取协程。
+//
+// 只对 cs2 打开：tutk 的命令通道由它自己的流程消费，
+// 额外再读会抢消息。
+func (c *Client) StartCommandReader() {
+	if c.cr != nil {
+		return
+	}
+	c.cr = &cmdReader{}
+
+	raw, ok := c.Conn.(rawCommandReader)
+	if !ok || !strings.HasPrefix(c.Conn.Protocol(), "cs2") {
+		return
+	}
+
+	go func(c *Client, raw rawCommandReader) {
+		for {
+			buf, ok := raw.ReadCommandRaw()
+			if !ok {
+				// 连接断了就退出；外层 producer 会感知到并重连。
+				return
+			}
+
+			outerCmd, body := splitCmd(buf)
+
+			// body 多数是加密的；解密失败就退回原始字节，
+			// 别把本来能读的 JSON 弄成乱码。
+			plain := c.DecodeCommand(body)
+			if !looksJSON(plain) && looksJSON(body) {
+				plain = body
+			}
+
+			// 解密后的 body 前面 4 个字节才是**真正的**命令号（大端），
+			// 后面是负载（多半是 JSON）。
+			cmd, payload := outerCmd, plain
+			if len(plain) >= 4 {
+				if sub := binary.BigEndian.Uint32(plain[:4]); knownCmdRes[sub] {
+					cmd = sub
+					payload = plain[4:]
+				}
+			}
+
+			c.cr.onCommand(cmd, payload, buf)
+		}
+	}(c, raw)
+}
+
+// MotorState 返回最近一次云台回包里的角度（水平 / 俯仰）。
+func (c *Client) MotorState() (angle, elev int, ok bool) {
+	if c.cr == nil {
+		return 0, 0, false
+	}
+	_, a, e, has := c.cr.snapshot()
+	return a, e, has
+}
+
+// MotorSeq 返回已收到的 cmdMotorRes 计数（用来判断回包是不是新来的）。
+func (c *Client) MotorSeq() uint64 {
+	if c.cr == nil {
+		return 0
+	}
+	seq, _, _, _ := c.cr.snapshot()
+	return seq
+}
+
+// WaitMotor 等一个新的云台回包，返回角度。
+func (c *Client) WaitMotor(prev uint64, timeout time.Duration) (angle, elev int, ok bool) {
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		if c.cr == nil {
+			return 0, 0, false
+		}
+		seq, a, e, has := c.cr.snapshot()
+		if seq > prev && has {
+			return a, e, true
+		}
+		time.Sleep(40 * time.Millisecond)
+	}
+	return 0, 0, false
+}
+
+// LastCommand 返回最近一条命令应答（排障用）。
+func (c *Client) LastCommand() (uint32, string, string) {
+	if c.cr == nil {
+		return 0, "", ""
+	}
+	return c.cr.last()
+}
