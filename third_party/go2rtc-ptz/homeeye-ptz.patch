+// HomeEye PTZ sidecar.
+//
+// Holds one Mi Home "miss" P2P session per camera and exposes a tiny HTTP API so
+// HomeEye can drive the pan/tilt motor (and later the two-way audio channel)
+// without touching the Xiaomi SDK it already uses for streaming.
+//
+// The cloud credentials are only used to fetch per-connection P2P parameters
+// (vendor / public key / sign), exactly like go2rtc does for its xiaomi:// source.
+package main
+
+import (
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"log"
+	"math"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/xiaomi"
+	"github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+	"github.com/AlexxIT/go2rtc/pkg/xiaomi/miss"
+)
+
+type CamCfg struct {
+	Name   string `json:"name"`
+	IP     string `json:"ip"`
+	DID    string `json:"did"`
+	Model  string `json:"model"`
+	Online *bool  `json:"online,omitempty"` // nil = 云端没给这个字段
+}
+
+type session struct {
+	cfg     CamCfg
+	client  *miss.Client
+	created time.Time
+	err     error
+	moves   int
+	lastOp  int
+	lastRes string
+	lastCmd uint32
+
+	// 下行媒体计数。audioLevel 是对讲自检的关键：往摄像头喇叭推音时，
+	// 如果它的麦克风把声音采了回来，这个值会明显抬起来——单会话就能验证
+	// 「喇叭真的响了吗」，不用再额外开一路会话去录音。
+	nextTry  time.Time // 拨号失败后的冷却截止时间
+	fails    int       // 连续拨号失败次数（退避用）
+	lastUse  time.Time // 最后一次被使用（用于空闲回收）
+
+	videoPkts  int
+	audioPkts  int
+	audioLevel float64 // 最近一包音频的 RMS，0..1
+	audioPeak  float64 // 本次会话听到过的最大峰值，0..1
+}
+
+// alawDecode 把 G.711 A-law 字节还原成 16bit PCM。
+func alawDecode(b byte) int16 {
+	a := int(b) ^ 0x55
+	t := (a & 0x0F) << 4
+	seg := (a & 0x70) >> 4
+	switch seg {
+	case 0:
+		t += 8
+	case 1:
+		t += 0x108
+	default:
+		t += 0x108
+		t <<= uint(seg - 1)
+	}
+	if a&0x80 != 0 {
+		return int16(t)
+	}
+	return int16(-t)
+}
+
+// audioStats 返回 (RMS, 峰值)，都归一化到 0..1。
+//
+// 必须按 codec 真正解码再算：A-law 的"数字静音"是 0x55/0xD5 交替，直接对字节
+// 统计标准差会有 0.5 的假读数，静音和说话完全分不开（踩过这个坑）。
+// codecPCMA=1027(A-law) / codecPCM=1024(裸 16bit) 都按真实采样算 RMS。
+func audioStats(payload []byte, codecID uint32) (float64, float64) {
+	if len(payload) == 0 {
+		return 0, 0
+	}
+
+	var sum, mx float64
+	n := 0
+	switch codecID {
+	case 1027: // A-law
+		for _, b := range payload {
+			v := float64(alawDecode(b))
+			sum += v * v
+			if v < 0 {
+				v = -v
+			}
+			if v > mx {
+				mx = v
+			}
+			n++
+		}
+	case 1024: // 裸 PCM16LE
+		for i := 0; i+1 < len(payload); i += 2 {
+			v := float64(int16(binary.LittleEndian.Uint16(payload[i:])))
+			sum += v * v
+			if v < 0 {
+				v = -v
+			}
+			if v > mx {
+				mx = v
+			}
+			n++
+		}
+	default: // 其他（OPUS 等）只能按字节粗略估，够判断有没有声音
+		for _, b := range payload {
+			v := int(b)
+			if v > 127 {
+				v -= 256
+			}
+			sum += float64(v * v)
+			n++
+		}
+	}
+	if n == 0 {
+		return 0, 0
+	}
+	return math.Sqrt(sum/float64(n)) / 32768.0, mx / 32768.0
+}
+
+// 摄像头对连接抖动极其敏感：短时间内反复拨号会被它"拉黑"，之后每次都会
+// 在建流后立刻 EOF。所以失败后的冷却必须指数退避，而不是固定几秒。
+const (
+	dialCooldownMin = 8 * time.Second
+	dialCooldownMax = 5 * time.Minute
+)
+
+var (
+	dialMu    sync.Mutex // 串行化拨号
+	userID    = os.Getenv("HEPTZ_USER")
+	passToken = os.Getenv("HEPTZ_TOKEN")
+	region    = envOr("HEPTZ_REGION", "cn")
+	transport = os.Getenv("HEPTZ_TRANSPORT")   // 空 = UDP/TCP 都试，和 go2rtc 默认一致
+	cams      []CamCfg
+	discovered map[string]CamCfg // did -> cfg，从米家云端自动拉取
+	sessions  = map[string]*session{}
+	mu        sync.Mutex
+	cloud     *xiaomi.Cloud
+)
+
+// discover 从米家云端拉设备列表，补全 did -> {ip, model} 映射。
+// HomeEye 侧的配置里只有 did，局域网 IP 和 model 由这里兜底获取。
+func discover() error {
+	cl, err := getCloud()
+	if err != nil {
+		return err
+	}
+	res, err := cl.Request(baseURL(region), "/v2/home/device_list_page", "{}", nil)
+	if err != nil {
+		return err
+	}
+	var v struct {
+		List []struct {
+			Did      string `json:"did"`
+			Name     string `json:"name"`
+			Model    string `json:"model"`
+			LocalIP  string `json:"localip"`
+			IsOnline *bool  `json:"isOnline"`
+		} `json:"list"`
+	}
+	if err = json.Unmarshal(res, &v); err != nil {
+		return err
+	}
+	m := map[string]CamCfg{}
+	for _, d := range v.List {
+		m[d.Did] = CamCfg{
+			Name: d.Name, IP: d.LocalIP, DID: d.Did, Model: d.Model,
+			Online: d.IsOnline,
+		}
+	}
+	mu.Lock()
+	discovered = m
+	mu.Unlock()
+	log.Printf("discovered %d devices from cloud", len(m))
+	return nil
+}
+
+func envOr(k, def string) string {
+	if v := os.Getenv(k); v != "" {
+		return v
+	}
+	return def
+}
+
+func baseURL(region string) string {
+	switch region {
+	case "de", "i2", "ru", "sg", "us":
+		return "https://" + region + ".api.io.mi.com/app"
+	}
+	return "https://api.io.mi.com/app"
+}
+
+func vendorName(i byte) string {
+	switch i {
+	case 1:
+		return "tutk"
+	case 3:
+		return "agora"
+	case 4:
+		return "cs2"
+	case 6:
+		return "mtp"
+	}
+	return fmt.Sprintf("%d", i)
+}
+
+func getCloud() (*xiaomi.Cloud, error) {
+	if cloud != nil {
+		return cloud, nil
+	}
+	c := xiaomi.NewCloud("xiaomiio")
+	if err := c.LoginWithToken(userID, passToken); err != nil {
+		return nil, fmt.Errorf("cloud login: %w", err)
+	}
+	cloud = c
+	return cloud, nil
+}
+
+// buildURL asks the Mi cloud for per-connection P2P parameters and assembles the
+// full xiaomi:// URL that miss.NewClient expects.
+func buildURL(cam CamCfg) (string, error) {
+	cl, err := getCloud()
+	if err != nil {
+		return "", err
+	}
+
+	clientPublic, clientPrivate, err := crypto.GenerateKey()
+	if err != nil {
+		return "", err
+	}
+
+	params := fmt.Sprintf(
+		`{"app_pubkey":"%x","did":"%s","support_vendors":"TUTK_CS2_MTP"}`,
+		clientPublic, cam.DID,
+	)
+
+	res, err := cl.Request(baseURL(region), "/v2/device/miss_get_vendor", params, nil)
+	if err != nil {
+		return "", fmt.Errorf("miss_get_vendor: %w", err)
+	}
+
+	var v struct {
+		Vendor struct {
+			ID     byte `json:"vendor"`
+			Params struct {
+				UID string `json:"p2p_id"`
+			} `json:"vendor_params"`
+		} `json:"vendor"`
+		PublicKey string `json:"public_key"`
+		Sign      string `json:"sign"`
+	}
+	if err = json.Unmarshal(res, &v); err != nil {
+		return "", fmt.Errorf("miss_get_vendor decode: %w (%s)", err, res)
+	}
+
+	q := url.Values{}
+	q.Set("did", cam.DID)
+	q.Set("model", cam.Model)
+	q.Set("client_public", hex.EncodeToString(clientPublic))
+	q.Set("client_private", hex.EncodeToString(clientPrivate))
+	q.Set("device_public", v.PublicKey)
+	q.Set("sign", v.Sign)
+	q.Set("vendor", vendorName(v.Vendor.ID))
+	q.Set("transport", transport)
+	if v.Vendor.ID == 1 {
+		q.Set("uid", v.Vendor.Params.UID)
+	}
+
+	return fmt.Sprintf("xiaomi://%s?%s", cam.IP, q.Encode()), nil
+}
+
+// failDial 记录一次失败的拨号，并给下一次尝试加上指数退避的冷却。
+func failDial(name string, cfg CamCfg, err error, prevFails int) {
+	fails := prevFails + 1
+	d := dialCooldownMin
+	for i := 1; i < fails && d < dialCooldownMax; i++ {
+		d *= 2
+	}
+	if d > dialCooldownMax {
+		d = dialCooldownMax
+	}
+	mu.Lock()
+	sessions[name] = &session{
+		cfg:     cfg,
+		err:     err,
+		fails:   fails,
+		nextTry: time.Now().Add(d),
+	}
+	mu.Unlock()
+	log.Printf("[%s] dial failed (%d in a row), retry in %s", name, fails, d)
+}
+
+// lookupCfg 找出摄像头的 {ip, model}。只读 cams / discovered。
+func lookupCfg(name string) (*CamCfg, error) {
+	for i := range cams {
+		if cams[i].Name == name || cams[i].DID == name {
+			c := cams[i]
+			return &c, nil
+		}
+	}
+
+	mu.Lock()
+	d, ok := discovered[name]
+	mu.Unlock()
+
+	if !ok {
+		if derr := discover(); derr != nil {
+			log.Printf("discover failed: %v", derr)
+		}
+		mu.Lock()
+		d, ok = discovered[name]
+		mu.Unlock()
+	}
+	if !ok || d.IP == "" {
+		return nil, fmt.Errorf("unknown camera: %s", name)
+	}
+	c := d
+	return &c, nil
+}
+
+func getSession(name string) (*session, error) {
+	mu.Lock()
+	cur := sessions[name]
+	mu.Unlock()
+	if cur != nil {
+		if cur.err == nil {
+			cur.lastUse = time.Now()
+			return cur, nil
+		}
+		// 刚断的会话不要立刻重拨：摄像头对并发会话数很敏感，一次失败就连着重拨
+		// 会把它的会话表挤满，接下来所有拨号都只换来一个 EOF（实测踩过）。
+		if wait := time.Until(cur.nextTry); wait > 0 {
+			return nil, fmt.Errorf("会话刚断开（%v），%.0f 秒后自动重试", cur.err, wait.Seconds())
+		}
+	}
+
+	// 拨号串行化：同一时刻只允许一个 dial，其余请求排队复用结果
+	dialMu.Lock()
+	defer dialMu.Unlock()
+	mu.Lock()
+	cur = sessions[name]
+	mu.Unlock()
+	if cur != nil {
+		if cur.err == nil {
+			cur.lastUse = time.Now()
+			return cur, nil
+		}
+		if wait := time.Until(cur.nextTry); wait > 0 {
+			return nil, fmt.Errorf("会话刚断开（%v），%.0f 秒后自动重试", cur.err, wait.Seconds())
+		}
+	}
+
+	prevF := 0
+	if cur != nil {
+		prevF = cur.fails
+	}
+
+	cfg, err := lookupCfg(name)
+	if err != nil {
+		return nil, err
+	}
+
+	// 云端明确标记离线时立刻返回，不要再去等 5~10 秒的 P2P 超时——
+	// 否则用户按一下云台按钮要卡十秒才看到「失败」。
+	if cfg.Online != nil && !*cfg.Online {
+		return nil, fmt.Errorf("offline: 摄像头离线（米家云端状态为离线，局域网 IP %s）", cfg.IP)
+	}
+
+	rawURL, err := buildURL(*cfg)
+	if err != nil {
+		failDial(name, *cfg, err, prevF)
+		return nil, err
+	}
+	log.Printf("[%s] dialing %s", name, rawURL[:min(len(rawURL), 40)])
+
+	// 注意：这一步是整个流程里唯一的长耗时点（UDP 打洞最多 ~10s），
+	// 全程不持锁，避免 /status 被一次失败的拨号卡死。
+	client, err := miss.NewClient(rawURL)
+	if err != nil {
+		failDial(name, *cfg, err, prevF)
+		return nil, fmt.Errorf("dial: %w", err)
+	}
+
+	s := &session{cfg: *cfg, client: client, created: time.Now(), lastUse: time.Now()}
+	mu.Lock()
+	sessions[name] = s
+	mu.Unlock()
+	log.Printf("[%s] connected via %s", name, client.Protocol())
+
+	// 摄像头只有在媒体通道建立后才认 motor 命令：不 StartMedia 的话写进去的
+	// 0x112 会被直接丢弃，紧接着连接被对端断开（表现为 broken pipe）。
+	// quality=1 是低码率子码流。下行音频默认关闭：在 069a01 + 子码流下开音频，
+	// 对端会立刻 EOF 掉整条会话（实测），关掉才稳。
+	mediaQuality := envOr("HEPTZ_MEDIA_QUALITY", "1")
+	mediaAudio := envOr("HEPTZ_MEDIA_AUDIO", "0")
+	if err = client.StartMedia("", mediaQuality, mediaAudio); err != nil {
+		log.Printf("[%s] StartMedia failed: %v", name, err)
+	} else {
+		log.Printf("[%s] media started (q=%s, audio=%s)", name, mediaQuality, mediaAudio)
+	}
+
+	// 读到 EOF/错误说明这条会话已经死了，必须立刻标记，下一条命令才会重新拨号。
+	// 不标记的话后续 motor 会一直往已关闭的 socket 写，永远报 broken pipe。
+	failSession := func(camName string, cause error) {
+		mu.Lock()
+		cur := sessions[camName]
+		if cur != nil && cur.client == client {
+			cur.err = cause
+			cur.fails++
+			d := dialCooldownMin
+			for i := 1; i < cur.fails && d < dialCooldownMax; i++ {
+				d *= 2
+			}
+			if d > dialCooldownMax {
+				d = dialCooldownMax
+			}
+			cur.nextTry = time.Now().Add(d)
+		}
+		mu.Unlock()
+		_ = client.Close()
+	}
+
+	// 必须持续读 channel2（媒体），否则 TCP 接收窗填满后摄像头会阻塞甚至断开
+	go func(c *miss.Client, camName string) {
+		for {
+			pkt, err := c.ReadPacket()
+			if err != nil {
+				log.Printf("[%s] media reader stopped: %v", camName, err)
+				failSession(camName, err)
+				return
+			}
+			switch pkt.CodecID {
+			case 4, 5: // H264 / H265
+				mu.Lock()
+				if cur := sessions[camName]; cur != nil {
+					cur.videoPkts++
+				}
+				mu.Unlock()
+			default: // 音频
+				rms, pk := audioStats(pkt.Payload, pkt.CodecID)
+				mu.Lock()
+				if cur := sessions[camName]; cur != nil {
+					cur.audioPkts++
+					cur.audioLevel = rms
+					if pk > cur.audioPeak {
+						cur.audioPeak = pk
+					}
+				}
+				mu.Unlock()
+			}
+		}
+	}(client, name)
+
+	// 更关键：channel0（命令通道）也必须读。摄像头对 motor 命令会回 cmdMotorRes
+	// (0x113)，缓冲区只有 10 个槽，不读就会灌满 -> Push 失败 -> worker 退出 ->
+	// 整条连接被关闭，下一条命令就报 broken pipe。
+	go func(c *miss.Client, camName string) {
+		for {
+			cmd, data, err := c.ReadCommand()
+			if err != nil {
+				log.Printf("[%s] cmd reader stopped: %v", camName, err)
+				failSession(camName, err)
+				return
+			}
+			plain := c.DecodeCommand(data)
+			log.Printf("[%s] <- cmd=0x%03x %s", camName, cmd, plain)
+			// 记录最后一次回包，方便 /status 排障（对讲就是靠 0x107 判断喇叭开没开）
+			mu.Lock()
+			if cur := sessions[camName]; cur != nil {
+				cur.lastRes = string(plain)
+				cur.lastCmd = cmd
+			}
+			mu.Unlock()
+		}
+	}(client, name)
+
+	return s, nil
+}
+
+func min(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+// ---- HTTP ----
+
+// motorWireOp 把对外约定（1 右 / 2 左）翻成 miss 协议的原生操作码（1 左 / 2 右）。
+func motorWireOp(op int) int {
+	switch op {
+	case 1:
+		return 2
+	case 2:
+		return 1
+	}
+	return op
+}
+
+func apiPTZ(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	name := q.Get("cam")
+	opStr := q.Get("op")
+	op, err := strconv.Atoi(opStr)
+	if err != nil || op < 0 || op > 15 {
+		http.Error(w, "bad op (0 stop,1 right,2 left,3 up,4 down)", http.StatusBadRequest)
+		return
+	}
+
+	s, err := getSession(name)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	if err = s.client.Motor(motorWireOp(op)); err != nil {
+		// 连接可能已死，标记一下，下次调用重连
+		mu.Lock()
+		sessions[name] = &session{cfg: s.cfg, err: err}
+		mu.Unlock()
+		http.Error(w, "motor: "+err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	mu.Lock()
+	s.moves++
+	s.lastOp = op
+	s.lastUse = time.Now()
+	moves := s.moves
+	mu.Unlock()
+
+	writeJSON(w, map[string]any{
+		"ok": true, "cam": name, "op": op, "moves": moves,
+		"protocol": s.client.Protocol(),
+	})
+}
+
+func apiStatus(w http.ResponseWriter, r *http.Request) {
+	mu.Lock()
+	defer mu.Unlock()
+
+	out := map[string]any{}
+	names := map[string]CamCfg{}
+	for _, c := range cams {
+		names[c.DID] = c
+	}
+	for did, c := range discovered {
+		names[did] = c
+	}
+	for did, c := range names {
+		s := sessions[did]
+		item := map[string]any{"name": c.Name, "model": c.Model, "ip": c.IP}
+		if c.Online != nil {
+			item["online"] = *c.Online
+		}
+		if talking, outBytes, frames, inBytes := talkSnapshot(did); talking || frames > 0 {
+			item["talking"] = talking
+			item["talkOut"] = outBytes
+			item["talkFrames"] = frames
+			item["talkIn"] = inBytes
+		}
+		if s == nil {
+			item["state"] = "idle"
+			out[did] = item
+			continue
+		}
+		item["moves"] = s.moves
+		item["lastOp"] = s.lastOp
+		item["videoPkts"] = s.videoPkts
+		item["audioPkts"] = s.audioPkts
+		item["audioLevel"] = fmt.Sprintf("%.3f", s.audioLevel)
+		item["audioPeak"] = fmt.Sprintf("%.3f", s.audioPeak)
+		if s.lastCmd != 0 {
+			item["lastCmd"] = fmt.Sprintf("0x%03x", s.lastCmd)
+		}
+		if s.lastRes != "" {
+			item["motorRes"] = s.lastRes
+		}
+		if s.err != nil {
+			item["state"] = "error"
+			item["error"] = s.err.Error()
+			if wait := time.Until(s.nextTry); wait > 0 {
+				item["retryIn"] = int(wait.Seconds()) + 1
+			}
+		} else {
+			item["state"] = "connected"
+			item["protocol"] = s.client.Protocol()
+			item["age"] = int(time.Since(s.created).Seconds())
+		}
+		out[did] = item
+	}
+	writeJSON(w, out)
+}
+
+func apiReconnect(w http.ResponseWriter, r *http.Request) {
+	name := r.URL.Query().Get("cam")
+	mu.Lock()
+	defer mu.Unlock()
+	if s := sessions[name]; s != nil && s.client != nil {
+		_ = s.client.Close()
+	}
+	delete(sessions, name)
+	writeJSON(w, map[string]any{"ok": true, "cam": name})
+}
+
+func writeJSON(w http.ResponseWriter, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+// touchSession 刷新会话的最后使用时间，防止空闲回收器把正在用的会话掐掉。
+func touchSession(name string) {
+	mu.Lock()
+	if s := sessions[name]; s != nil {
+		s.lastUse = time.Now()
+	}
+	mu.Unlock()
+}
+
+// idleReaper 定期回收空闲会话。
+//
+// 为什么必须有：摄像头（小米 P2P）的并发会话上限实测是 3 条。同一个 NAS 上
+// 通常已经有 HomeEye 自己的取流会话（1 条）和 go2rtc 的会话（1 条），云台侧车
+// 再占 1 条正好卡满。此时任何一方重连失败，就会出现「互相把对方踢掉」的
+// 死循环（表现是 cs2: EOF）。
+//
+// 所以侧车不能常驻占位：闲置一段时间就主动断开，把名额还给取流。
+// 用户下次按云台按钮时再重新拨号（UDP 打洞约 1 秒，用户无感）。
+func idleReaper() {
+	timeout := time.Duration(envInt("HEPTZ_IDLE_SECONDS", 45)) * time.Second
+	if timeout <= 0 {
+		log.Printf("idle reaper disabled")
+		return
+	}
+	log.Printf("idle reaper: sessions released after %s of inactivity", timeout)
+
+	tick := timeout / 3
+	if tick < 5*time.Second {
+		tick = 5 * time.Second
+	}
+	for range time.Tick(tick) {
+		mu.Lock()
+		var drop []*session
+		now := time.Now()
+		for name, s := range sessions {
+			if s.client == nil || s.err != nil {
+				continue
+			}
+			// 对讲进行中不能回收，否则会把用户的语音掐断
+			if t := talks[name]; t != nil && t.active {
+				continue
+			}
+			if now.Sub(s.lastUse) > timeout {
+				drop = append(drop, s)
+				delete(sessions, name)
+			}
+		}
+		mu.Unlock()
+
+		for _, s := range drop {
+			log.Printf("[%s] idle %s, releasing session", s.cfg.DID, timeout)
+			_ = s.client.Close()
+		}
+	}
+}
+
+// envInt 读整数环境变量，缺省或非法时返回 def。
+func envInt(name string, def int) int {
+	v := strings.TrimSpace(os.Getenv(name))
+	if v == "" {
+		return def
+	}
+	n, err := strconv.Atoi(v)
+	if err != nil {
+		return def
+	}
+	return n
+}
+
+func main() {
+	if userID == "" || passToken == "" {
+		log.Fatal("HEPTZ_USER / HEPTZ_TOKEN required")
+	}
+	if raw := os.Getenv("HEPTZ_CAMS"); raw != "" {
+		if err := json.Unmarshal([]byte(raw), &cams); err != nil {
+			log.Fatalf("HEPTZ_CAMS: %v", err)
+		}
+	}
+
+	if _, err := getCloud(); err != nil {
+		log.Printf("warn: cloud prewarm failed: %v", err)
+	} else {
+		log.Printf("cloud ready, user=%s region=%s, %d local cams", userID, region, len(cams))
+		if derr := discover(); derr != nil {
+			log.Printf("discover failed: %v", derr)
+		}
+	}
+
+	addr := envOr("HEPTZ_ADDR", "0.0.0.0:8899")
+	mux := http.NewServeMux()
+	mux.HandleFunc("/ptz", apiPTZ)
+	mux.HandleFunc("/status", apiStatus)
+	mux.HandleFunc("/reconnect", apiReconnect)
+	mux.HandleFunc("/talk/start", apiTalkStart)
+	mux.HandleFunc("/talk/stop", apiTalkStop)
+	mux.HandleFunc("/talk/mic", apiTalkMic)
+	mux.HandleFunc("/talk", apiTalkPush)
+	mux.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("ok"))
+	})
+
+	go talkJanitor()
+	go idleReaper()
+
+	log.Printf("heptz listening on %s", addr)
+	if err := http.ListenAndServe(addr, mux); err != nil {
+		log.Fatal(err)
+	}
+}
diff --git a/cmd/heptz/talk.go b/cmd/heptz/talk.go
new file mode 100644
index 0000000..01d7922
--- /dev/null
+++ b/cmd/heptz/talk.go
@@ -0,0 +1,301 @@
+// 对讲（摄像头上行语音）通道。
+//
+// 链路：浏览器麦克风 -> HomeEye -> 本进程（A-law 编码 + 40ms 分帧）->
+//       miss channel3 -> 摄像头喇叭。
+//
+// 摄像头只认「PCMA / 8kHz / 每包 40ms」这种最朴素的送法（Go2rtc 也是这么干的），
+// 所以这里固定把输入规整成 16bit 8kHz 单声道，再由本进程转 A-law。
+package main
+
+import (
+	"encoding/binary"
+	"io"
+	"log"
+	"net/http"
+	"sync"
+	"time"
+)
+
+// 40ms @ 8kHz：320 个采样
+const (
+	pcmFrameBytes = 320 * 2 // 16bit -> 640
+	alawFrameSize = 320     // 8bit  -> 320
+	talkIdleStop  = 8 * time.Second
+)
+
+type talkState struct {
+	mu     sync.Mutex
+	buf    []byte // 还没凑满 40ms 的 PCM16 余量
+	active bool
+	sent   int // 已写出的 A-law 字节数
+	frames int
+	in     int // 收到的 PCM16 字节数
+	lastIn time.Time
+}
+
+var (
+	talksMu sync.Mutex
+	talks   = map[string]*talkState{}
+)
+
+func getTalk(name string) *talkState {
+	talksMu.Lock()
+	defer talksMu.Unlock()
+	t := talks[name]
+	if t == nil {
+		t = &talkState{}
+		talks[name] = t
+	}
+	return t
+}
+
+// talkSnapshot 给 /status 用的只读快照。
+func talkSnapshot(name string) (active bool, outBytes, frames, inBytes int) {
+	talksMu.Lock()
+	t := talks[name]
+	talksMu.Unlock()
+	if t == nil {
+		return false, 0, 0, 0
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.active, t.sent, t.frames, t.in
+}
+
+// ---- G.711 A-law 编码（Sun/CCITT 参考实现，输入按 13bit 处理） ----
+
+var alawSegEnd = [8]int16{0x1F, 0x3F, 0x7F, 0xFF, 0x1FF, 0x3FF, 0x7FF, 0xFFF}
+
+func alawSearch(v int16) int {
+	for i := 0; i < 8; i++ {
+		if v <= alawSegEnd[i] {
+			return i
+		}
+	}
+	return 8
+}
+
+func alawEncodeSample(pcm int16) byte {
+	v := pcm >> 3
+	var mask byte
+	if v >= 0 {
+		mask = 0xD5
+	} else {
+		mask = 0x55
+		v = -v - 1
+	}
+	seg := alawSearch(v)
+	if seg >= 8 {
+		return 0x7F ^ mask
+	}
+	aval := byte(seg) << 4
+	if seg < 2 {
+		aval |= byte(v>>1) & 0x0F
+	} else {
+		aval |= byte(v>>uint(seg)) & 0x0F
+	}
+	return aval ^ mask
+}
+
+func alawEncode(pcm []byte) []byte {
+	n := len(pcm) / 2
+	out := make([]byte, n)
+	for i := 0; i < n; i++ {
+		out[i] = alawEncodeSample(int16(binary.LittleEndian.Uint16(pcm[i*2:])))
+	}
+	return out
+}
+
+// ---- HTTP ----
+
+// apiTalkStart 打开喇叭通道。摄像头回 0x107 才代表真的开了。
+func apiTalkStart(w http.ResponseWriter, r *http.Request) {
+	name := r.URL.Query().Get("cam")
+
+	s, err := getSession(name)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	t := getTalk(name)
+	t.mu.Lock()
+	t.buf = nil
+	t.sent, t.frames, t.in = 0, 0, 0
+	t.active = true
+	t.lastIn = time.Now()
+	t.mu.Unlock()
+
+	// 对讲期间会话不能被空闲回收器掐断
+	touchSession(name)
+
+	if err = s.client.StartSpeaker(); err != nil {
+		t.mu.Lock()
+		t.active = false
+		t.mu.Unlock()
+		http.Error(w, "speaker start: "+err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	// 官方 App 打开喇叭通道后会空一小会儿再推音频，照做更稳。
+	time.Sleep(300 * time.Millisecond)
+
+	log.Printf("[%s] talk started (%s)", name, s.client.SpeakerCodecName())
+	writeJSON(w, map[string]any{
+		"ok": true, "cam": name, "codec": s.client.SpeakerCodecName(),
+	})
+}
+
+// apiTalkPush 接收裸 PCM16LE / 8kHz / 单声道，切帧后写到 channel3。
+func apiTalkPush(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "POST required", http.StatusMethodNotAllowed)
+		return
+	}
+	name := r.URL.Query().Get("cam")
+
+	s, err := getSession(name)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	body, err := io.ReadAll(io.LimitReader(r.Body, 1<<20))
+	if err != nil {
+		http.Error(w, "read body: "+err.Error(), http.StatusBadRequest)
+		return
+	}
+	if len(body) == 0 {
+		writeJSON(w, map[string]any{"ok": true, "frames": 0})
+		return
+	}
+
+	t := getTalk(name)
+	t.mu.Lock()
+	t.in += len(body)
+	t.lastIn = time.Now()
+	t.buf = append(t.buf, body...)
+	var frames [][]byte
+	for len(t.buf) >= pcmFrameBytes {
+		frames = append(frames, append([]byte(nil), t.buf[:pcmFrameBytes]...))
+		t.buf = t.buf[pcmFrameBytes:]
+	}
+	t.mu.Unlock()
+
+	touchSession(name)
+
+	codec := s.client.SpeakerCodecID()
+	written := 0
+	for _, f := range frames {
+		var out []byte
+		if codec == 1024 { // codecPCM：Dafang/小方这类裸 PCM16 机型，直接透传
+			out = f
+		} else {
+			out = alawEncode(f)
+		}
+		if err = s.client.WriteAudio(codec, out); err != nil {
+			log.Printf("[%s] talk write failed: %v", name, err)
+			t.mu.Lock()
+			t.active = false
+			t.mu.Unlock()
+			http.Error(w, "write audio: "+err.Error(), http.StatusBadGateway)
+			return
+		}
+		written += len(out)
+	}
+
+	t.mu.Lock()
+	t.sent += written
+	t.frames += len(frames)
+	sent, total := t.sent, t.frames
+	t.mu.Unlock()
+
+	writeJSON(w, map[string]any{
+		"ok": true, "frames": len(frames), "bytes": written,
+		"total_frames": total, "total_bytes": sent,
+	})
+}
+
+// apiTalkStop 关闭喇叭通道。
+func apiTalkStop(w http.ResponseWriter, r *http.Request) {
+	name := r.URL.Query().Get("cam")
+
+	t := getTalk(name)
+	t.mu.Lock()
+	t.active = false
+	sent, frames, in := t.sent, t.frames, t.in
+	t.buf = nil
+	t.mu.Unlock()
+
+	mu.Lock()
+	s := sessions[name]
+	mu.Unlock()
+
+	if s != nil && s.err == nil && s.client != nil {
+		if err := s.client.StopSpeaker(); err != nil {
+			log.Printf("[%s] speaker stop: %v", name, err)
+		}
+	}
+	log.Printf("[%s] talk stopped (in=%dB out=%dB frames=%d)", name, in, sent, frames)
+
+	writeJSON(w, map[string]any{
+		"ok": true, "cam": name, "in_bytes": in, "out_bytes": sent, "frames": frames,
+	})
+}
+
+// apiTalkMic 显式开/关摄像头麦克风，用来区分"喇叭没出声"和"麦克风没开"。
+func apiTalkMic(w http.ResponseWriter, r *http.Request) {
+	name := r.URL.Query().Get("cam")
+	s, err := getSession(name)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+		return
+	}
+	on := r.URL.Query().Get("on") != "0"
+	if on {
+		err = s.client.StartMic()
+	} else {
+		err = s.client.StopMic()
+	}
+	if err != nil {
+		http.Error(w, "mic: "+err.Error(), http.StatusBadGateway)
+		return
+	}
+	log.Printf("[%s] mic (0x104) on=%v", name, on)
+	writeJSON(w, map[string]any{"ok": true, "cam": name, "on": on})
+}
+
+// talkJanitor 兜底：浏览器卡死/断网时前端来不及发 stop，8 秒静默后自动关通道，
+// 否则摄像头喇叭会一直占着（还会把环境音回放出来）。
+func talkJanitor() {
+	for range time.Tick(2 * time.Second) {
+		now := time.Now()
+
+		talksMu.Lock()
+		names := make([]string, 0, len(talks))
+		for n := range talks {
+			names = append(names, n)
+		}
+		talksMu.Unlock()
+
+		for _, name := range names {
+			t := getTalk(name)
+			t.mu.Lock()
+			idle := t.active && now.Sub(t.lastIn) > talkIdleStop
+			if idle {
+				t.active = false
+			}
+			t.mu.Unlock()
+			if !idle {
+				continue
+			}
+			mu.Lock()
+			s := sessions[name]
+			mu.Unlock()
+			if s != nil && s.err == nil && s.client != nil {
+				_ = s.client.StopSpeaker()
+			}
+			log.Printf("[%s] talk auto-stopped after idle", name)
+		}
+	}
+}
diff --git a/homeeye-build-image.sh b/homeeye-build-image.sh
new file mode 100644
index 0000000..1d78562
--- /dev/null
+++ b/homeeye-build-image.sh
@@ -0,0 +1,97 @@
+#!/bin/sh
+# 从本仓库源码构建 HomeEye 定制版 go2rtc 镜像 —— 一条命令从 git 到镜像。
+#
+#   sh homeeye-build-image.sh                              # 打当前工作树
+#   GIT_REF=v1.9.15-ptz.1 sh homeeye-build-image.sh        # 先切到某个 tag 再打
+#   TAG=homeeye/go2rtc:1.0.7-ptz sh homeeye-build-image.sh # 升版本时换标签
+#
+# 为什么镜像要自己构建：生产用的是 alexxit/go2rtc:master-hardware 打底、
+# 只替换 /usr/local/bin/go2rtc 本体。官方 master-hardware 那层的 ffmpeg 与
+# 核显驱动是硬件转码要的，我们的补丁只改 Go 源码，所以叠加是等价且最小的做法。
+#
+# 注意：千万不要把二进制直接 bind mount 进运行中的容器再覆盖 —— 会 "Text file busy"。
+# 要走镜像：build 完改 compose 的 image，再 docker compose up -d --force-recreate。
+set -e
+
+TAG="${TAG:-homeeye/go2rtc:1.0.6-ptz}"
+BASE="${BASE:-alexxit/go2rtc:master-hardware}"
+GOIMG="${GOIMG:-golang:1.26-alpine}"
+REPO="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+SRC="${SRC:-$REPO}"
+WORK=/tmp/he-g2r-image
+SMOKE_PORT="${SMOKE_PORT:-19850}"
+SMOKE_IN=1985
+
+echo "== 0. 取源码 =="
+if [ -n "$GIT_REF" ]; then
+  git -C "$SRC" checkout "$GIT_REF" || { echo "checkout $GIT_REF 失败"; exit 1; }
+fi
+git -C "$SRC" rev-parse --short HEAD 2>/dev/null || echo "   （非 git 工作树，直接编 $SRC）"
+
+echo "== 1. 基础镜像 =="
+docker image inspect "$BASE" >/dev/null 2>&1 || docker pull "$BASE"
+echo "   $BASE 就绪"
+
+echo "== 2. 编译静态二进制（容器里编，宿主机不需要 Go 工具链） =="
+rm -rf "$WORK"
+mkdir -p "$WORK/out" "$WORK/ctx/config"
+# STRIP=0 编出来的二进制与"手工 go build ./"等价，用来验证本仓库能逐字节复现现网
+# 镜像里那份（sha256 对得上才算 fork 真的进了版本控制）；日常出镜像用默认 STRIP=1，小一半。
+# 用 set -- 传参：-ldflags 的值里有空格，走普通变量会在 word 拆分时被切开。
+if [ "${STRIP:-1}" = "1" ]; then
+  set -- -trimpath -ldflags "-s -w"
+else
+  set --
+fi
+docker run --rm \
+  -v "$SRC":/src:ro \
+  -v "$WORK/out":/out \
+  -v /tmp/gocache:/go \
+  -w /src \
+  -e GOPROXY=https://goproxy.cn,direct \
+  -e CGO_ENABLED=0 \
+  -e GOFLAGS=-mod=mod \
+  "$GOIMG" go build "$@" -o /out/go2rtc ./
+ls -l "$WORK/out/go2rtc"
+sha256sum "$WORK/out/go2rtc"
+"$WORK/out/go2rtc" --version 2>/dev/null | head -2 || file "$WORK/out/go2rtc"
+
+echo "== 3. 构建 $TAG =="
+cp "$WORK/out/go2rtc" "$WORK/ctx/go2rtc"
+chmod 755 "$WORK/ctx/go2rtc"
+cat > "$WORK/ctx/Dockerfile" <<EOF
+FROM $BASE
+COPY go2rtc /usr/local/bin/go2rtc
+RUN chmod 755 /usr/local/bin/go2rtc
+EOF
+docker build -q -t "$TAG" "$WORK/ctx"
+docker image inspect "$TAG" --format 'built: {{.Id}} size={{.Size}}'
+
+echo "== 4. 冒烟回归：补丁接口必须在，且不能撞到现网 go2rtc =="
+# 单独一个 bridge 网络容器 + 自己的端口映射，绝不碰 127.0.0.1:1984 那个在跑的。
+cat > "$WORK/ctx/config/go2rtc.yaml" <<EOF
+api:
+  listen: ":$SMOKE_IN"
+EOF
+docker rm -f he-g2r-smoke >/dev/null 2>&1 || true
+docker run -d --name he-g2r-smoke \
+  -v "$WORK/ctx/config":/config \
+  -p 127.0.0.1:$SMOKE_PORT:$SMOKE_IN \
+  "$TAG" >/dev/null
+sleep 4
+PTZ=$(curl -s --max-time 8 "http://127.0.0.1:$SMOKE_PORT/api/xiaomi/ptz" || echo "")
+code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "http://127.0.0.1:$SMOKE_PORT/api/xiaomi/motor?did=0&op=0" || echo 000)
+STREAMS=$(curl -s --max-time 8 "http://127.0.0.1:$SMOKE_PORT/api/streams" | head -c 120)
+docker rm -f he-g2r-smoke >/dev/null 2>&1 || true
+
+echo "   /api/xiaomi/ptz   : $PTZ"
+echo "   /api/xiaomi/motor : HTTP $code"
+echo "   /api/streams      : $STREAMS"
+
+case "$PTZ" in
+  *"not found"*|*"404"*|"") echo "FAIL: /api/xiaomi/ptz 不在 —— 这个镜像没带上云台补丁"; exit 1 ;;
+esac
+[ "$code" = "404" ] && { echo "FAIL: /api/xiaomi/motor 404，补丁没生效"; exit 1; }
+[ -n "$STREAMS" ] || { echo "FAIL: /api/streams 空，本体没起来"; exit 1; }
+
+echo "OK: $TAG （源码 $SRC）"
diff --git a/internal/xiaomi/ptz.go b/internal/xiaomi/ptz.go
new file mode 100644
index 0000000..3a6d1a0
--- /dev/null
+++ b/internal/xiaomi/ptz.go
@@ -0,0 +1,269 @@
+package xiaomi
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/internal/api"
+	"github.com/AlexxIT/go2rtc/pkg/pcm"
+	"github.com/AlexxIT/go2rtc/pkg/xiaomi/miss"
+)
+
+// 云台 / 对讲接口。
+//
+// 设计要点：这些命令**不新建 P2P 会话**，而是在 go2rtc 已经为这路流建立的
+// 那条 miss 会话上下发（见 pkg/xiaomi/miss/registry.go）。原因很实在：
+// 小米摄像头的并发会话上限只有 3 条，如果 HomeEye 另开一条去发云台命令，
+// 摄像头的会话表就会挤满，结果是所有人互相把对方踢掉（cs2: EOF）。
+//
+// 用法：
+//   GET  /api/xiaomi/motor?did=1234567890&op=1     op: 1右 2左 3上 4下 0停
+//   POST /api/xiaomi/speaker?did=1234567890         打开对讲通道
+//   POST /api/xiaomi/audio?did=1234567890           body = 裸 A-law/PCM16
+//   POST /api/xiaomi/speaker/stop?did=1234567890    关闭对讲通道
+//
+// 注意 op 的方向和对内下发的操作码是**反的**，见 motorWireOp。
+
+// talkBuf 攒音频用：A-law 8k 一帧 40ms = 320 字节。
+const talkFrameBytes = 320
+
+var (
+	talkMu    sync.Mutex
+	talkState = map[string]*talkBufState{}
+)
+
+type talkBufState struct {
+	buf    []byte
+	active bool
+	frames int
+	bytes  int
+}
+
+// motorWireOp 把对外的方向约定（1 右 / 2 左）翻成 miss 协议的原生操作码。
+//
+// 原生码是 1 左 / 2 右（见 pkg/xiaomi/miss/motor.go），和对外的约定正好相反。
+// 实测（抓转动前后的画面做互相关）：原生 op=1 时画面内容右移，即镜头向左转。
+// 以前这里直接透传，结果就是"点右往左转"。
+func motorWireOp(op int) int {
+	switch op {
+	case 1:
+		return 2
+	case 2:
+		return 1
+	}
+	return op
+}
+
+// apiXiaomiMotor 云台控制。
+func apiXiaomiMotor(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+
+	did := q.Get("did")
+	if did == "" {
+		http.Error(w, "missing did", http.StatusBadRequest)
+		return
+	}
+
+	opStr := q.Get("op")
+	op, err := strconv.Atoi(opStr)
+	if err != nil || op < 0 || op > 15 {
+		http.Error(w, "bad op (0 stop, 1 right, 2 left, 3 up, 4 down)", http.StatusBadRequest)
+		return
+	}
+
+	wire := motorWireOp(op)
+
+	if err = miss.Clients.Motor(did, wire); err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	log.Info().Msgf("[xiaomi] motor did=%s op=%d wire=%d", did, op, wire)
+
+	// 不等回包。摄像头对「停」从不回 0x113，转向回包也要几百毫秒，而按住
+	// 方向盘时前端每 0.3 秒就发一条 —— 在这里等满 1.2 秒会把请求排成队，
+	// 表现就是"点了半天没反应"。朝向回最近一次回包的值即可（/api/xiaomi/ptz
+	// 里也是这个值）。
+	out := map[string]any{"ok": true, "did": did, "op": op}
+	if angle, elev, ok := miss.Clients.MotorState(did); ok {
+		out["angle"] = angle
+		out["elevation"] = elev
+	}
+	api.ResponseJSON(w, out)
+}
+
+// apiXiaomiSpeaker 打开/关闭对讲通道。
+func apiXiaomiSpeaker(w http.ResponseWriter, r *http.Request) {
+	did := r.URL.Query().Get("did")
+	if did == "" {
+		http.Error(w, "missing did", http.StatusBadRequest)
+		return
+	}
+
+	if r.URL.Query().Get("stop") != "" {
+		_ = miss.Clients.StopSpeaker(did)
+		talkMu.Lock()
+		delete(talkState, did)
+		talkMu.Unlock()
+		api.ResponseJSON(w, map[string]any{"ok": true, "did": did, "talking": false})
+		return
+	}
+
+	codec, name, err := miss.Clients.SpeakerCodec(did)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	if err = miss.Clients.StartSpeaker(did); err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	talkMu.Lock()
+	talkState[did] = &talkBufState{active: true}
+	talkMu.Unlock()
+
+	// 官方 App 打开喇叭后空一小会儿再推音频，照做更稳
+	time.Sleep(300 * time.Millisecond)
+
+	log.Info().Msgf("[xiaomi] speaker start did=%s codec=%s", did, name)
+	api.ResponseJSON(w, map[string]any{"ok": true, "did": did, "codec": name, "codecID": codec})
+}
+
+// apiXiaomiAudio 接收对讲音频。
+//
+// body 约定：**PCM16 / 小端 / 8kHz / 单声道**（浏览器 getUserMedia 出来的就是这个）。
+// 由 go2rtc 这边转成摄像头要的格式：
+//   * PCMA（G.711 A-law，8bit/8k）机型 —— 转成 A-law，一帧 40ms = 320 字节
+//   * PCM16 机型 —— 原样送，一帧 40ms = 640 字节
+//   * OPUS 机型 —— 暂不支持
+//
+// 之前这里假设「调用方送来的已经是摄像头原生格式」，结果 PCM16 被当 A-law 切帧，
+// 摄像头那边收到的是乱码（声音又尖又快）。
+func apiXiaomiAudio(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "POST required", http.StatusMethodNotAllowed)
+		return
+	}
+
+	did := r.URL.Query().Get("did")
+	if did == "" {
+		http.Error(w, "missing did", http.StatusBadRequest)
+		return
+	}
+
+	codec, _, err := miss.Clients.SpeakerCodec(did)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadGateway)
+		return
+	}
+
+	body, err := io.ReadAll(io.LimitReader(r.Body, 512*1024))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	if len(body) == 0 {
+		api.ResponseJSON(w, map[string]any{"ok": true, "frames": 0})
+		return
+	}
+
+	inBytes := len(body)
+
+	var frameBytes int
+	switch codec {
+	case 1027: // PCMA
+		body = pcm16ToPCMA(body)
+		frameBytes = talkFrameBytes
+	case 1024: // PCM16
+		frameBytes = talkFrameBytes * 2
+	default:
+		http.Error(w, "unsupported talk codec for this camera", http.StatusBadRequest)
+		return
+	}
+
+	talkMu.Lock()
+	st := talkState[did]
+	if st == nil {
+		st = &talkBufState{active: true}
+		talkState[did] = st
+	}
+	st.buf = append(st.buf, body...)
+	var frames [][]byte
+	for len(st.buf) >= frameBytes {
+		frames = append(frames, append([]byte(nil), st.buf[:frameBytes]...))
+		st.buf = st.buf[frameBytes:]
+	}
+	talkMu.Unlock()
+
+	for _, f := range frames {
+		if err = miss.Clients.WriteAudio(did, codec, f); err != nil {
+			http.Error(w, "write audio: "+err.Error(), http.StatusBadGateway)
+			return
+		}
+	}
+
+	talkMu.Lock()
+	st.frames += len(frames)
+	st.bytes += inBytes
+	framesOut, bytesOut := st.frames, st.bytes
+	talkMu.Unlock()
+
+	api.ResponseJSON(w, map[string]any{
+		"ok": true, "frames": framesOut, "bytes": bytesOut,
+		"frameBytes": frameBytes,
+	})
+}
+
+// pcm16ToPCMA 把 16bit 小端 PCM 转成 G.711 A-law。
+func pcm16ToPCMA(src []byte) []byte {
+	n := len(src) / 2
+	out := make([]byte, n)
+	for i := 0; i < n; i++ {
+		v := int16(binary.LittleEndian.Uint16(src[i*2:]))
+		out[i] = pcm.PCMtoPCMA(v)
+	}
+	return out
+}
+
+// apiXiaomiStatus 查询云台/对讲的可用状态（供 HomeEye 探测）。
+func apiXiaomiStatus(w http.ResponseWriter, r *http.Request) {
+	dids := miss.Clients.Dids()
+	out := map[string]any{}
+	for _, did := range dids {
+		codec, name, err := miss.Clients.SpeakerCodec(did)
+		if err != nil {
+			// 连接已死，清理掉
+			continue
+		}
+		item := map[string]any{
+			"session": true,
+			"codec":   name,
+			"codecID": codec,
+		}
+		if angle, elev, ok := miss.Clients.MotorState(did); ok {
+			item["angle"] = angle
+			item["elevation"] = elev
+		}
+		if cmd, msg, raw := miss.Clients.LastCommand(did); cmd != 0 {
+			item["lastCmd"] = cmd
+			item["lastMsg"] = msg
+			item["lastRaw"] = raw
+		}
+		talkMu.Lock()
+		st := talkState[did]
+		if st != nil {
+			item["talkFrames"] = st.frames
+			item["talkBytes"] = st.bytes
+		}
+		talkMu.Unlock()
+		out[did] = item
+	}
+	_ = json.NewEncoder(w).Encode(out)
+}
