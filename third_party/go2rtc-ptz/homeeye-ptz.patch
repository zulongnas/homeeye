+			time.Sleep(3 * time.Second)
+			Clients.Unregister(did, client)
+		}()
+	}
 	_ = p.client.StopMedia()
 	return p.Connection.Stop()
 }
diff --git a/pkg/xiaomi/miss/registry.go b/pkg/xiaomi/miss/registry.go
new file mode 100644
index 0000000..235200a
--- /dev/null
+++ b/pkg/xiaomi/miss/registry.go
@@ -0,0 +1,195 @@
+package miss
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// errNoSession 表示这台摄像头当前没有可用的 miss 会话。
+func errNoSession(did string) error {
+	return fmt.Errorf("摄像头 %s 当前没有活跃的取流会话，请先在 HomeEye 里打开这路画面", did)
+}
+
+// Registry 记录所有活跃的 miss 客户端，按 did 索引。
+//
+// 为什么需要它：小米摄像头的 P2P 并发会话上限很低（实测 3 条），而云台
+// (cmdMotorReq) 和对讲 (cmdSpeakerStartReq) 都必须走同一条已建立的 miss
+// 会话——另开一条就会把摄像头的会话表挤满，导致所有客户端互相把对方踢掉
+// （表现是 cs2: EOF）。
+//
+// 所以：go2rtc 自己取流时用的那条会话，同时也能接受云台/对讲命令。
+// 上层（HTTP API）通过这个注册表找到对应客户端，直接在已有连接上下发命令，
+// 不新增任何 P2P 会话。
+type Registry struct {
+	mu      sync.RWMutex
+	clients map[string]*Client
+}
+
+func NewRegistry() *Registry {
+	return &Registry{clients: map[string]*Client{}}
+}
+
+// Register 登记一个客户端。同一 did 重复注册时保留后来的（说明旧连接已失效）。
+func (r *Registry) Register(did string, client *Client) {
+	r.mu.Lock()
+	r.clients[did] = client
+	r.mu.Unlock()
+}
+
+// Unregister 注销（连接关闭时调用）。
+func (r *Registry) Unregister(did string, client *Client) {
+	r.mu.Lock()
+	if c, ok := r.clients[did]; ok && (client == nil || c == client) {
+		delete(r.clients, did)
+	}
+	r.mu.Unlock()
+}
+
+// Get 按 did 取客户端。
+func (r *Registry) Get(did string) *Client {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	return r.clients[did]
+}
+
+// alive 检查客户端的底层连接是否还活着。
+// go2rtc 的 producer 断开后表里可能还留着旧 client（注销有 3 秒延迟），
+// 直接用会往一条死连接上发命令，表现为 broken pipe。
+func (c *Client) alive() bool {
+	if c == nil {
+		return false
+	}
+	// SetDeadline(零值) 会成功返回 nil，说明连接没断；断了会返回错误
+	return c.SetDeadline(time.Time{}) == nil
+}
+
+// Dids 返回当前登记的所有 did。
+func (r *Registry) Dids() []string {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	out := make([]string, 0, len(r.clients))
+	for did := range r.clients {
+		out = append(out, did)
+	}
+	return out
+}
+
+// Motor 对指定 did 的摄像头下发云台命令。
+// operation: 1 右 / 2 左 / 3 上 / 4 下 / 0 停。
+func (r *Registry) Motor(did string, operation int) error {
+	client := r.live(did)
+	if client == nil {
+		return errNoSession(did)
+	}
+	return client.Motor(operation)
+}
+
+// MotorWait 下发云台命令并等一个回包，返回 (角度, 俯仰, 是否拿到)。
+//
+// 摄像头回的是 cmdMotorRes(0x113)，里面带 {"angle":..,"elevation":..}，
+// 也就是摄像头当前的真实朝向 —— 比我们自己累加角度准得多。
+//
+// 注意：**不要**先调 Motor 再调这个（会发两次命令）。
+// 正确用法是先取 MotorSeq 作为基线，再发命令，最后等回包。
+func (r *Registry) MotorWait(did string, operation int, timeout time.Duration) (int, int, bool) {
+	client := r.live(did)
+	if client == nil {
+		return 0, 0, false
+	}
+
+	prev := client.MotorSeq()
+
+	if err := client.Motor(operation); err != nil {
+		return 0, 0, false
+	}
+
+	return client.WaitMotor(prev, timeout)
+}
+
+// MotorSeq 返回该摄像头已收到的 cmdMotorRes 计数。
+func (r *Registry) MotorSeq(did string) uint64 {
+	client := r.live(did)
+	if client == nil {
+		return 0
+	}
+	return client.MotorSeq()
+}
+
+// WaitMotor 等一个新的云台回包（基线 seq 由调用方在发命令前取）。
+func (r *Registry) WaitMotor(did string, prev uint64, timeout time.Duration) (int, int, bool) {
+	client := r.live(did)
+	if client == nil {
+		return 0, 0, false
+	}
+	return client.WaitMotor(prev, timeout)
+}
+
+// MotorState 返回该摄像头最近一次已知的朝向。
+func (r *Registry) MotorState(did string) (int, int, bool) {
+	client := r.live(did)
+	if client == nil {
+		return 0, 0, false
+	}
+	return client.MotorState()
+}
+
+// LastCommand 返回该摄像头最近一条命令应答（排障用）。
+func (r *Registry) LastCommand(did string) (uint32, string, string) {
+	client := r.live(did)
+	if client == nil {
+		return 0, "", ""
+	}
+	return client.LastCommand()
+}
+
+// live 取出仍然可用的客户端；连接已死的顺手清掉表项。
+func (r *Registry) live(did string) *Client {
+	r.mu.RLock()
+	c := r.clients[did]
+	r.mu.RUnlock()
+	if c == nil {
+		return nil
+	}
+	if !c.alive() {
+		r.Unregister(did, c)
+		return nil
+	}
+	return c
+}
+
+// StartSpeaker 打开对讲（喇叭）通道。
+func (r *Registry) StartSpeaker(did string) error {
+	client := r.live(did)
+	if client == nil {
+		return errNoSession(did)
+	}
+	return client.StartSpeaker()
+}
+
+// StopSpeaker 关闭对讲通道。
+func (r *Registry) StopSpeaker(did string) error {
+	client := r.live(did)
+	if client == nil {
+		return errNoSession(did)
+	}
+	return client.StopSpeaker()
+}
+
+// WriteAudio 写入一帧对讲音频（已按机型编码好的 PCMA / PCM16）。
+func (r *Registry) WriteAudio(did string, codec uint32, payload []byte) error {
+	client := r.live(did)
+	if client == nil {
+		return errNoSession(did)
+	}
+	return client.WriteAudio(codec, payload)
+}
+
+// SpeakerCodec 返回该摄像头的对讲编码格式。
+func (r *Registry) SpeakerCodec(did string) (uint32, string, error) {
+	client := r.live(did)
+	if client == nil {
+		return 0, "", errNoSession(did)
+	}
+	return client.SpeakerCodecID(), client.SpeakerCodecName(), nil
+}
diff --git a/pkg/xiaomi/miss/speaker.go b/pkg/xiaomi/miss/speaker.go
new file mode 100644
index 0000000..f9ac2d1
--- /dev/null
+++ b/pkg/xiaomi/miss/speaker.go
@@ -0,0 +1,53 @@
+package miss
+
+import "encoding/binary"
+
+// 摄像头上行语音（对讲）相关。
+//
+// 流程：StartSpeaker() -> 以 40ms 为单位 WriteAudioPCM()/WriteAudio() 反复写 ->
+//       StopSpeaker()。摄像头收到 cmdSpeakerStartReq(0x106) 后回 cmdSpeakerStartRes
+//       (0x107)，回包正常才说明喇叭通道真的开了。
+
+// StopSpeaker 关闭喇叭通道。
+func (c *Client) StopSpeaker() error {
+	data := binary.BigEndian.AppendUint32(nil, cmdSpeakerStop)
+	return c.WriteCommand(data)
+}
+
+// StartMic 显式打开摄像头的麦克风（0x104）。
+//
+// StartMedia(enableaudio=1) 只是让媒体通道带音频轨，实测在 069a01 上拿到的
+// 仍然是 A-law 静音；要真正听到麦克风，还得单独发这条命令。
+func (c *Client) StartMic() error {
+	data := binary.BigEndian.AppendUint32(nil, cmdAudioStart)
+	return c.WriteCommand(data)
+}
+
+// StopMic 关闭摄像头麦克风（0x105）。
+func (c *Client) StopMic() error {
+	data := binary.BigEndian.AppendUint32(nil, cmdAudioStop)
+	return c.WriteCommand(data)
+}
+
+// SpeakerCodecID 返回该型号上行语音要用的 codec。
+// 大部分机型是 PCMA（G.711 A-law，8bit/8kHz）；Dafang/小方是裸 PCM16；
+// chuangmi.camera.72ac1 是 OPUS。
+func (c *Client) SpeakerCodecID() uint32 {
+	if id := c.SpeakerCodec(); id != 0 {
+		return id
+	}
+	return codecPCMA
+}
+
+// SpeakerCodecName 给日志和前端看的可读名字。
+func (c *Client) SpeakerCodecName() string {
+	switch c.SpeakerCodecID() {
+	case codecPCM:
+		return "PCM16/8k"
+	case codecOPUS:
+		return "OPUS/48k"
+	case codecPCMA:
+		return "PCMA/8k"
+	}
+	return "unknown"
+}
