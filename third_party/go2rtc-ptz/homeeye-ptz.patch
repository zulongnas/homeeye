diff --git a/pkg/xiaomi/miss/motor.go b/pkg/xiaomi/miss/motor.go
new file mode 100644
index 0000000..4c490b2
--- /dev/null
+++ b/pkg/xiaomi/miss/motor.go
@@ -0,0 +1,43 @@
+package miss
+
+import (
+	"encoding/binary"
+	"fmt"
+
+	"github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+)
+
+// DecodeCommand decrypts a payload that arrived on the command channel (0).
+//
+// Motor responses (cmdMotorRes 0x113) carry a JSON body such as
+// {"angle":..,"elevation":..,"xAngle":..,"yAngle":..}, which lets callers read
+// the current physical position instead of guessing.
+func (c *Client) DecodeCommand(data []byte) []byte {
+	if len(data) <= 8 {
+		return data
+	}
+	if out, err := crypto.Decode(data, c.key); err == nil {
+		return out
+	}
+	return data
+}
+
+// Motor sends a pan/tilt motor command to the camera.
+//
+// operation: 1 - left, 2 - right, 3 - up, 4 - down.
+// This is the same frame the Mi Home app sends (cmdMotorReq 0x112 + JSON body).
+// The camera keeps moving until a stop command arrives, so callers must send
+// Motor(0) — or the model specific stop — after releasing the button.
+func (c *Client) Motor(operation int) error {
+	data := binary.BigEndian.AppendUint32(nil, cmdMotorReq)
+	data = fmt.Appendf(data, `{"operation":%d}`, operation)
+	return c.WriteCommand(data)
+}
+
+// MotorStatus sends the same command with a calibration/status style payload.
+// Some firmwares answer with cmdMotorRes (0x113) carrying the current angles.
+func (c *Client) MotorStatus() error {
+	data := binary.BigEndian.AppendUint32(nil, cmdMotorReq)
+	data = fmt.Appendf(data, `{"operation":0}`)
+	return c.WriteCommand(data)
+}
